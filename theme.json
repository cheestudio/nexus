      "minHeight": false,
      "aspectRatios": [
        {
          "name": "Portrait Alt - 4:5",
          "slug": "4-5",
          "ratio": "4/5"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "wideSize": "calc(100vw - 2 * var(--wide-constrainer, 20px))",
      "contentSize": "calc(100vw - 2 * var(--constrainer, 20px))"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "size": "10px",
          "slug": "10",
          "name": "10px"
        },
        {
          "size": "15px",
          "slug": "15",
          "name": "15px"
        },
        {
          "size": "20px",
          "slug": "20",
          "name": "20px"
        },
        {
          "size": "25px",
          "slug": "25",
          "name": "25px"
        },
        {
          "size": "30px",
          "slug": "30",
          "name": "30px"
        },
        {
          "size": "var(--spacing40)",
          "slug": "40",
          "name": "40px"
        },
        {
          "size": "var(--spacing50)",
          "slug": "50",
          "name": "50px"
        },
        {
          "size": "var(--spacing60)",
          "slug": "60",
          "name": "60px"
        },
        {
          "size": "var(--spacing70)",
          "slug": "70",
          "name": "70px"
        },
        {
          "size": "var(--spacing80)",
          "slug": "80",
          "name": "80px"
        },
        {
          "size": "var(--spacing90)",
          "slug": "90",
          "name": "90px"
        },
        {
          "size": "var(--spacing100)",
          "slug": "100",
          "name": "100px"
        },
        {
          "size": "var(--spacing125)",
          "slug": "125",
          "name": "125px"
        },
        {
          "size": "var(--spacing150)",
          "slug": "150",
          "name": "150px"
        }
      ]
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "shadow": {
      "defaultPresets": false
    },
    "color": {
      "custom": false,
      "duotone": [],
