  "styles": {
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-1)",
          "lineHeight": "1.031",
          "fontWeight": "725",
          "fontFamily": "var(--wp--preset--font-family--heading)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-2)",
          "lineHeight": "1.044",
          "fontWeight": "725",
          "fontFamily": "var(--wp--preset--font-family--heading)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-3)",
          "lineHeight": "1.129",
          "fontWeight": "725",
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "letterSpacing": "0.31px"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-4)",
          "lineHeight": "1.115",
          "fontWeight": "700",
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-5)",
          "lineHeight": "1.158",
          "fontWeight": "700",
          "fontFamily": "var(--wp--preset--font-family--body)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h-6)",
          "lineHeight": "1.286",
          "fontWeight": "700",
          "fontFamily": "var(--wp--preset--font-family--body)",
          "letterSpacing": "0.7px",
          "textTransform": "uppercase"
        }
      }
    },
    "blocks": {
      "CHEENAMESPACE/page-hero": {
        "spacing": {
          "margin": "0"
        }
      },
      "core/group": {
        "spacing": {
          "margin": "0"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var(--spacing50)"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5625rem",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "1.25rem",
        "right": "1.25rem"
      }
    }
