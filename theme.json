    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "defaultFontSizes": false,
      "fluid": {
        "minFontSize": "18px",
        "maxViewportWidth": "1392px",
        "minViewportWidth": "480px"
      },
      "fontFamilies": [
        {
          "name": "Heading",
          "slug": "heading",
          "fontFamily": "Georgia, serif"
        },
        {
          "name": "Body",
          "slug": "body",
          "fontFamily": "Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "h1",
          "size": "65px",
          "name": "H1",
          "fluid": {
            "min": "36px"
          }
        },
        {
          "slug": "h2",
          "size": "45px",
          "name": "H2",
          "fluid": {
            "min": "30px"
          }
        },
        {
          "slug": "h3",
          "size": "31px",
          "name": "H3",
          "fluid": {
            "min": "22px"
          }
        },
        {
          "slug": "h4",
          "size": "26px",
          "name": "H4",
          "fluid": {
            "min": "20px"
          }
        },
        {
          "slug": "h5",
          "size": "19px",
          "name": "H5",
          "fluid": false
        },
        {
          "slug": "h6",
          "size": "14px",
          "name": "H6",
          "fluid": false
